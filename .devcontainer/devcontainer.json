// For format details, see https://aka.ms/devcontainer.json.
//
// This file is deliberately thin. Everything shared - mounts, extensions,
// settings, containerEnv and the lifecycle hooks - is supplied by the base
// image's devcontainer.metadata label and merged in automatically, with this
// file taking precedence on any conflict.
//
// Only what the spec cannot put in image metadata belongs here: name, build,
// runArgs, features. Those happen to be exactly the settings that legitimately
// differ between projects, which is why the split works.
//
// See .devcontainer/common/ for the shared scripts (vendored, refreshed by
// sync-common.sh before every build) and .devcontainer/site.env for local knobs.
{
	"name": "pocket-nebula",

	"build": {
		// Path is relative to the devcontainer.json file.
		"dockerfile": "Dockerfile",
		"args": {
			// set vscode devcontainer arg for Dockerfile validation
			"vscodedevcontainer": "true"
		}
	},

	// Runs on the HOST, before the image is built. This ordering is the point:
	// it refreshes .devcontainer/common/ from the pinned ref in common.ref so a
	// shared-layer change lands in the same create cycle - never rebuild, spot
	// drift, rebuild again. Falls back to the vendored copy when offline.
	"initializeCommand": ".devcontainer/sync-common.sh",

	"runArgs": [
		// Load environment variables from devcontainer.env as a fallback, for
		// cases where remoteEnv ${localEnv:...} does not resolve (e.g. Remote-SSH).
		"--env-file=.devcontainer/devcontainer.env"
	],

	// OpenNebula credentials are NOT imported from the host environment. They are
	// selected deterministically by common/setup.sh from the read-only ~/.one mount
	// and exported through the env file. Importing ${localEnv:ONE_*} would let a
	// host exporting another deployment's credentials - or an empty ONE_AUTH -
	// shadow the selected values in every terminal, so the CLI would either
	// authenticate as the wrong user or fail with "ONE_AUTH file not present".
	// Only ANSIBLE_VAULT_PASSWORD is legitimately host-provided.
	"remoteEnv": {
		"ANSIBLE_VAULT_PASSWORD": "${localEnv:ANSIBLE_VAULT_PASSWORD}"
	},

	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			// Replaces the feature's large default tool list. virtualenv and
			// argcomplete are all we need: the feature's real job here is providing
			// pipx (and PIPX_BIN_DIR=/usr/local/py-utils/bin, where ruff.path points),
			// while argcomplete supplies register-python-argcomplete for
			// common/shell-completions.sh.
			"toolsToInstall": "virtualenv, argcomplete"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	"mounts": [
		// Shared mounts (~/.ssh, ~/.one, ~/.ansible-vault) come from the base image.
		// Only the per-project history volume is named here, since it must not be
		// shared between projects.
		"source=pocket-nebula-bashhistory,target=/commandhistory,type=volume"
	],

	"customizations": {
		"vscode": {
			// WORKAROUND - see common/fix-cursor-python-extensions.sh for the full
			// set of upstream links. Note we canNOT uninstall ms-python.vscode-python-envs:
			// redhat.ansible declares it as a hard extensionDependency (alongside
			// ms-python.python and redhat.vscode-yaml), so removing it degrades the
			// Ansible extension. The postAttach script installs the platform-specific
			// VSIXes instead, which is the actual fix.
			"uninstallExtensions": [
				"ms-python.vscode-pylance"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
