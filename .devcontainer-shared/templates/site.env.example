# Site configuration for the shared OpenNebula devcontainer layer.
#
# Copy to .devcontainer/site.env and edit. common/setup.sh sources this with `set -a`
# so every value is exported.
#
# COMMITTED - no secrets. Credentials live in ~/.one/one_auth or one_auth_<SUFFIX>
# on the host and are never copied into the repo.

# ---------------------------------------------------------------------------
# OpenNebula endpoints (not secrets - safe to commit)
# ---------------------------------------------------------------------------
# Ruby CLI reads ONE_XMLRPC; Ansible inventory reads ONE_URL. Set both explicitly.
ONE_URL=https://cloud.example.com/RPC2
ONE_XMLRPC=https://cloud.example.com/RPC2
ONEFLOW_URL=https://cloud.example.com:2474

# ---------------------------------------------------------------------------
# Deployment selection
# ---------------------------------------------------------------------------
# When ~/.one/ holds multiple credential files, this suffix selects one_auth_<SUFFIX>.
# When only one credential file exists, it is used if unset or if the suffix matches.
# Container setup fails if several auth files exist and this is unset.
# OPENNEBULA_DEPLOYMENT_ENVIRONMENT=AcorpPROD

# ---------------------------------------------------------------------------
# Interactive credential picker (optional, default off)
# ---------------------------------------------------------------------------
# Requires a TTY during container create. Prefer setting the suffix above.
# ONE_ALLOW_INTERACTIVE_SELECT=1

# ---------------------------------------------------------------------------
# Version pinning
# ---------------------------------------------------------------------------
#   *_VERSION_OVERRIDE   always wins, whether or not detection would have worked.
#   *_VERSION_FALLBACK   applies ONLY when live detection against the server fails.
OPENNEBULA_CLI_VERSION_FALLBACK="~> 7.4"
PYONE_VERSION_FALLBACK="~=7.4.0"

# OPENNEBULA_CLI_VERSION_OVERRIDE="~> 7.4"
# PYONE_VERSION_OVERRIDE="~=7.4.0"

# ---------------------------------------------------------------------------
# SSH host aliases (optional)
# ---------------------------------------------------------------------------
# SSH_ALIASES="git-example:git.example.ac.uk:~/.ssh/id_ed25519"
